# Publish only the curated project.
/*
!/.gitattributes
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.gitignore
!/README.md
!/environment.yml
!/pyproject.toml
!/requirements.txt
!/configs/
!/configs/**
!/data/
!/data/sample.xlsx
!/models/
!/models/**
!/notebooks/
!/notebooks/modeling.ipynb
!/scripts/
!/scripts/**
!/src/
!/src/**
!/tests/
!/tests/**

# Ignore generated Python and analysis output.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/outputs/
